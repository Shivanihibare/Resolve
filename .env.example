# ============================================================================
# IGNOU BCA Major Project (BCSP-064) Environment Configuration
# Project: AI-Driven IT Service Desk and Automated Ticket Triage System
# ============================================================================

# Google Gemini API Key for Server-Side Automated Ticket Triage
# Provided by runtime environment or entered in development
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application Hosting Port
PORT=3000

# JSON Web Token Secret for RBAC Session Management
JWT_SECRET="bcsp-064-ignou-jwt-secret-key-2026"

# Repository Database Mode
# Options: 'memory' (default/in-memory fallback) | 'mysql' (real MySQL database via mysql2 connection pool)
DATABASE_MODE="memory"

# Relational Database Connection (MySQL 8.0+)
# Example: mysql://username:password@localhost:3306/service_desk_db
# Active when DATABASE_MODE="mysql"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="service_desk_db"

# SMTP Service Configuration for Customer Resolution Emails
# When SMTP_HOST is populated, emails are dispatched live via SMTP.
# Safe Dev Outbox Queue (/agent/emails) remains active in both modes.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@servicedesk.org"
SMTP_PASS=""
SMTP_FROM="IT Service Desk <notifications@servicedesk.org>"

# App URL
APP_URL="http://localhost:3000"
